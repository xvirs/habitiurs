<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_card_bg">

    <TextView
        android:id="@+id/streak_fire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/streak_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/w_on_surface"
        android:textSize="32sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/streak_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="días de racha"
            android:textColor="@color/w_on_surface_var"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/streak_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mejor: 0 días"
            android:textColor="@color/w_check_todo"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

    </LinearLayout>

</LinearLayout>
