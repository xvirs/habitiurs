<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mis_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_card_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Misiones"
            android:textColor="@color/w_on_surface_var"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/mis_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/w_check_todo"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/mis_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Sin misiones pendientes 🎉"
        android:textColor="@color/w_on_surface_var"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Filas -->
    <LinearLayout
        android:id="@+id/mis_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/mis_row0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/mis_dot0" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot_solid" android:layout_marginEnd="9dp" />
            <TextView android:id="@+id/mis_title0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:text="" android:textColor="@color/w_on_surface" android:textSize="13sp" />
            <TextView android:id="@+id/mis_due0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/w_check_todo" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/mis_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/mis_dot1" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot_solid" android:layout_marginEnd="9dp" />
            <TextView android:id="@+id/mis_title1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:text="" android:textColor="@color/w_on_surface" android:textSize="13sp" />
            <TextView android:id="@+id/mis_due1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/w_check_todo" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/mis_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/mis_dot2" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_dot_solid" android:layout_marginEnd="9dp" />
            <TextView android:id="@+id/mis_title2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:text="" android:textColor="@color/w_on_surface" android:textSize="13sp" />
            <TextView android:id="@+id/mis_due2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/w_check_todo" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón nueva misión -->
    <TextView
        android:id="@+id/mis_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="＋ Nueva misión"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_btn_accent" />

</LinearLayout>
